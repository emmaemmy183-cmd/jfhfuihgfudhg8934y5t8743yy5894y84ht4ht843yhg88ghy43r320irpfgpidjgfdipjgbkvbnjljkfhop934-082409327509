# Kopiere als .env und trage NEUE Tokens ein. Niemals auf GitHub hochladen.
TURSO_MAIN_URL=libsql://your-database.turso.io
TURSO_MAIN_TOKEN=REPLACE_WITH_YOUR_OWN_SECRET
TURSO_MEDIA_URL=libsql://your-database.turso.io
TURSO_MEDIA_TOKEN=REPLACE_WITH_YOUR_OWN_SECRET
IP_HASH_SECRET=REPLACE_WITH_YOUR_OWN_SECRET
PUBLIC_ORIGIN=https://your-domain.example
REGISTRATION_MODE="local"
COUNTRY_LOCK="off"
LEGACY_DATING_ENABLED="false"
SENDPULSE_API_KEY=REPLACE_WITH_YOUR_OWN_SECRET
MAIL_FROM=example@your-verified-domain.example
MAIL_REPLY_TO=example@your-verified-domain.example
MAIL_ENABLED="false"
EMAIL_HOURLY_CAP="10"
