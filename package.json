{
  "name": "kennely",
  "version": "2027.7.0",
  "private": true,
  "type": "module",
  "description": "Kennely Social DE ab 16: Netlify Functions, Turso, Fotos, Stories und Nachrichten",
  "scripts": {
    "dev": "netlify dev",
    "deploy": "netlify deploy --build",
    "db:migrate": "node --env-file=.dev.vars scripts/migrate.mjs",
    "db:check": "node --env-file=.dev.vars scripts/diagnose.mjs",
    "test": "node --test tests/*.test.mjs",
    "owner:assign": "node --env-file=.dev.vars scripts/assign-owner.mjs",
    "official:assign": "node --env-file=.dev.vars scripts/assign-official.mjs",
    "check:js": "node --check netlify/functions/api.mjs && node --check netlify/edge-functions/country-gate.js && node --check public/social-app.js && node --check src/server/index.js",
    "db:schema": "node --env-file=.dev.vars scripts/check-schema.mjs",
    "start": "node server/node-server.mjs",
    "user:delete": "node --env-file=.dev.vars scripts/delete-user.mjs",
    "dev:node": "node --env-file=.dev.vars server/node-server.mjs",
    "deploy:prod": "netlify deploy --build --prod",
    "check:netlify": "node --test tests/netlify-adapter.test.mjs"
  },
  "devDependencies": {
    "netlify-cli": "^23.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
