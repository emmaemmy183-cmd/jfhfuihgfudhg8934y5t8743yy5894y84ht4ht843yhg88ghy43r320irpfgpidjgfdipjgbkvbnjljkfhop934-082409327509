{
  "name": "kennely",
  "version": "2027.6.0",
  "private": true,
  "type": "module",
  "description": "Kennely Social DE ab 16: Fotos, Stories, Nachrichten, Node.js und Turso",
  "scripts": {
    "dev": "node --env-file=.dev.vars server/node-server.mjs",
    "deploy": "wrangler deploy",
    "db:migrate": "node --env-file=.dev.vars scripts/migrate.mjs",
    "db:check": "node --env-file=.dev.vars scripts/diagnose.mjs",
    "test": "node --test tests/*.test.mjs",
    "owner:assign": "node --env-file=.dev.vars scripts/assign-owner.mjs",
    "official:assign": "node --env-file=.dev.vars scripts/assign-official.mjs",
    "check:js": "node --check public/social-app.js && node --check src/server/social.js && node --check src/server/index.js && node --check server/node-server.mjs",
    "db:schema": "node --env-file=.dev.vars scripts/check-schema.mjs",
    "start": "node server/node-server.mjs",
    "user:delete": "node --env-file=.dev.vars scripts/delete-user.mjs"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.10.0"
  },
  "optionalDependencies": {
    "geoip-lite": "^1.4.10"
  }
}
